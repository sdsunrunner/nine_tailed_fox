{
  "name": "nine-tailed-fox",
  "version": "0.1.0",
  "private": true,
  "description": "九尾狐 - 短剧全流程一站式 AI 生产工作台",
  "scripts": {
    "dev:server": "pnpm --filter @fox/server dev",
    "dev:web": "pnpm --filter @fox/web dev",
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "db:push": "pnpm --filter @fox/server db:push",
    "db:seed": "pnpm --filter @fox/server db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
